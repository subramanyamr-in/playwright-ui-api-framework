{
  "name": "framewright",
  "version": "1.0.0",
  "author": "Subramanyam Reddy",
  "description": "Enterprise-grade Playwright TypeScript End-to-End (E2E) Test Automation Framework featuring Page Object Model, custom UI fixtures, Allure reporting, Winston logging, and multi-environment configuration.",
  "homepage": "https://github.com/subramanyamr-in/playwright-ui-api-framework#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subramanyamr-in/playwright-ui-api-framework.git"
  },
  "bugs": {
    "url": "https://github.com/subramanyamr-in/playwright-ui-api-framework/issues"
  },
  "private": true,
  "scripts": {
    "test": "npx playwright test",
    "test:ui": "npx playwright test tests/e2e",
    "test:api": "npx playwright test tests/api",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,mjs,cjs,json,md}": [
      "prettier --write"
    ],
    "*.{ts,js,mjs,cjs}": [
      "eslint --fix"
    ]
  },
  "keywords": [
    "playwright",
    "typescript",
    "test-automation",
    "e2e-testing",
    "page-object-model",
    "allure-report",
    "winston-logger",
    "testing-framework",
    "qa-automation",
    "framewright"
  ],
  "license": "MIT",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/crypto-js": "^4.2.2",
    "@types/node": "^26.2.0",
    "@types/randomstring": "^1.3.0",
    "@types/string-format": "^2.0.3",
    "@types/xml2js": "^0.4.14",
    "allure-js-commons": "^3.10.2",
    "allure-playwright": "^3.10.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xml2js": "^0.6.2"
  },
  "dependencies": {
    "crypto-js": "^4.2.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.4.2",
    "randomstring": "^1.3.1",
    "string-format": "^2.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3"
  }
}
