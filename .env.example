# ==============================================================================
# FrameWright - Environment Configuration Template (.env.example)
# Copy this file to .env or .env.{environment} (e.g. .env.qa, .env.prod)
# ==============================================================================

# Framework & Execution Target Environment
# Supported values: qa | dev | stage | prod
ENVIRONMENT=qa

# Application URLs
UI_BASE_URL=https://the-internet.herokuapp.com
API_BASE_URL=https://jsonplaceholder.typicode.com

# Test User Credentials
TEST_USER_EMAIL=user@example.com
TEST_USER_PASSWORD=your_secure_password

# Browser Target & Viewport
# Supported values: chromium | firefox | webkit | mobile_chrome | mobile_safari
BROWSER=chromium
HEADLESS=true

# Execution Control & Parallelism
TEST_TIMEOUT=600000
RETRIES=0
WORKERS=4

# Playwright Diagnostics & Reporting Artifacts
TRACE=on-first-retry
SCREENSHOT=only-on-failure
VIDEO=retain-on-failure

# Logging & Report Metadata
LOG_LEVEL=info
REPORT_TITLE=FrameWright Automation Execution Report
